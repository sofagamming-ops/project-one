<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Sport V</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container">
      <div class="header-content">
        <a href="/" class="logo">
          <i class="fas fa-running"></i>
          <span>Sport V</span>
        </a>
        
        <nav class="nav">
          <a href="/products" class="nav-link">All Products</a>
          <a href="/products?category=Gloves" class="nav-link">Gloves</a>
          <a href="/products?category=Shin Guards" class="nav-link">Shin Guards</a>
          <a href="/products?category=Mouth Guards" class="nav-link">Mouth Guards</a>
          <a href="/products?category=Groin Guards" class="nav-link">Groin Guards</a>
          <a href="/products?category=Shorts" class="nav-link">Shorts</a>
        </nav>

        <div class="header-actions">
          <form action="/products" method="GET" class="search-form">
            <input type="text" name="search" placeholder="Search products..." class="search-input">
            <button type="submit" class="search-btn">
              <i class="fas fa-search"></i>
            </button>
          </form>
          <a href="/cart" class="cart-icon">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-count">0</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main">
    <div class="container">
      <div class="error-page">
        <div class="error-icon">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h1>Oops! Something went wrong</h1>
        <p class="error-message"><%= message %></p>
        <% if (typeof error !== 'undefined' && error.stack) { %>
          <pre class="error-stack"><%= error.stack %></pre>
        <% } %>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <i class="fas fa-home"></i> Go Home
          </a>
          <a href="/products" class="btn btn-secondary">
            <i class="fas fa-store"></i> Browse Products
          </a>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h3>Sport V</h3>
          <p>Your premier destination for quality sports equipment and apparel.</p>
        </div>
        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/products">All Products</a></li>
            <li><a href="/products?category=Gloves">Gloves</a></li>
            <li><a href="/products?category=Shin Guards">Shin Guards</a></li>
            <li><a href="/products?category=Mouth Guards">Mouth Guards</a></li>
            <li><a href="/products?category=Groin Guards">Groin Guards</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Contact</h4>
          <ul>
            <li><i class="fas fa-envelope"></i> info@sportv.com</li>
            <li><i class="fas fa-phone"></i> +1 (555) 123-4567</li>
            <li><i class="fas fa-map-marker"></i> 123 Sports Street</li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Follow Us</h4>
          <div class="social-links">
            <a href="#"><i class="fab fa-facebook"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024 Sport V. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>